# Pre-commit hook for Breakdown RS Backend
# Runs: gitleaks, rustfmt, clippy, cargo check, ast-grep guardrails
# To install: cd backend && ln -sf ../../git-hooks/pre-commit .git/hooks/pre-commit
#
# The ast-grep steps mirror the cqrs-boundary / test-shim-leak / error-hygiene
# / rust-security-ast-grep jobs in .github/workflows/architecture-checks.yml.
# Keep the path scoping in sync with backend/rules/*.yml and the CI jobs.

set -e

echo "🔍 Running pre-commit hooks for backend..."
echo ""

# Change to backend directory
cd "$(git rev-parse --show-toplevel)/backend"

# Get list of staged Rust files. `--relative` is required: the hook has
# cd'ed into backend/, so plain `--name-only` would emit repo-root paths
# (backend/crates/...) that the ^crates/ filters and gitleaks could not match.
STAGED_RS_FILES=$(git diff --cached --relative --name-only --diff-filter=ACM | grep '\.rs$' || true)

# 1. Run gitleaks on all staged files
echo "📝 Checking for secrets with gitleaks..."
if command -v gitleaks &> /dev/null; then
    # Only check staged files (backend-relative paths so gitleaks can find them)
    STAGED_FILES=$(git diff --cached --relative --name-only)
    if [ -n "$STAGED_FILES" ]; then
        echo "$STAGED_FILES" | xargs -r gitleaks protect --verbose --redact --staged
    fi
    echo "✓ Gitleaks passed"
else
    echo "⚠️  Warning: gitleaks not installed. Install with: cargo install gitleaks"
    echo "   Or download from: https://github.com/gitleaks/gitleaks/releases"
fi
echo ""

# 2. Check Rust formatting
if [ -n "$STAGED_RS_FILES" ]; then
    echo "🎨 Checking Rust formatting (cargo fmt)..."
    cargo fmt --check --all
    echo "✓ Formatting OK"
    echo ""
fi

# 3. Run clippy
if [ -n "$STAGED_RS_FILES" ]; then
    echo "🔧 Running Clippy (cargo clippy)..."
    cargo clippy --all-targets --all-features -- -D warnings
    echo "✓ Clippy passed"
    echo ""
fi

# 4. Quick cargo check
if [ -n "$STAGED_RS_FILES" ]; then
    echo "✓ Running cargo check..."
    cargo check --all-targets --all-features
    echo "✓ Cargo check passed"
    echo ""
fi

# 5. Run ast-grep guardrails on staged files (mirrors the CI jobs)
if [ -n "$STAGED_RS_FILES" ]; then
    echo "🛡️  Running ast-grep guardrails (cqrs-boundary / test-shim-leak / discard-result / test-helper-gate / uuid-v7-only / allow-panic-lint-justification / s2-extension-ban / problem-code-registry / reqwest-no-dangerous-tls / reqwest-no-hardcoded-auth)..."
    if command -v ast-grep &> /dev/null; then
        # Write-side dirs → cqrs-boundary rule (see backend/rules/cqrs-boundary.yml).
        # AI workers are write-side code too and must stay projection-free.
        WRITE_SIDE_FILES=$(echo "$STAGED_RS_FILES" | grep -E '^crates/infra/src/(event_store|sagas|photo/sagas|ai)/' || true)
        if [ -n "$WRITE_SIDE_FILES" ]; then
            echo "$WRITE_SIDE_FILES" | xargs -r ast-grep scan -r rules/cqrs-boundary.yml
        fi
        # Production api files (test modules excluded) → test-shim-leak rule
        API_PROD_FILES=$(echo "$STAGED_RS_FILES" | grep '^crates/api/src/' \
            | grep -vE '_tests\.rs$|_test\.rs$|test_helpers\.rs$|/tests/|/test_helpers/' || true)
        if [ -n "$API_PROD_FILES" ]; then
            echo "$API_PROD_FILES" | xargs -r ast-grep scan -r rules/test-shim-leak.yml
        fi
        # All production source files (tests excluded) → discard-result +
        # test-helper-gate rules (issue #165 review learnings) + uuid-v7-only
        # (AGENTS.md §3 "No UUIDv4") + allow-panic-lint-justification (§3
        # escape-hatch comment requirement).
        PROD_FILES=$(echo "$STAGED_RS_FILES" | grep '^crates/.*/src/' \
            | grep -vE '_tests\.rs$|_test\.rs$|test_helpers\.rs$|/tests/|/test_helpers/' || true)
        if [ -n "$PROD_FILES" ]; then
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/discard-result.yml
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/test-helper-gate.yml
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/uuid-v7-only.yml
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/allow-panic-lint-justification.yml
            # Rust security rules (issue #262, vendored from
            # coderabbitai/ast-grep-essentials): no reqwest TLS bypasses, no
            # hardcoded HTTP auth credentials.
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/reqwest-no-dangerous-tls.yml
            echo "$PROD_FILES" | xargs -r ast-grep scan -r rules/reqwest-no-hardcoded-auth.yml
        fi
        # UUIDv7-only rule also applies to test files (AGENTS.md §3).
        TEST_FILES=$(echo "$STAGED_RS_FILES" | grep -E '(/tests/.*\.rs$|_tests\.rs$|_test\.rs$)' || true)
        if [ -n "$TEST_FILES" ]; then
            echo "$TEST_FILES" | xargs -r ast-grep scan -r rules/uuid-v7-only.yml
        fi
        # Problem-builder code → S2 person-identifier ban (ADR-031 D4).
        PROBLEM_FILES=$(echo "$STAGED_RS_FILES" | grep '^crates/api/src/problems/' || true)
        if [ -n "$PROBLEM_FILES" ]; then
            echo "$PROBLEM_FILES" | xargs -r ast-grep scan -r rules/s2-extension-ban.yml
        fi
        # Problem-code registry (issue #232): every `pub const …: ProblemCode`
        # must be declared through the problem_codes! macro in
        # crates/core/src/error_registry.rs. Runs the same shared, syntax-aware
        # checker as the problem-code-registry CI job (no logic duplication).
        bash scripts/check-problem-code-registry.sh crates/
        echo "✓ ast-grep guardrails passed"
    else
        echo "⚠️  Warning: ast-grep not installed. Install with: cargo install ast-grep"
        echo "   Or download from: https://github.com/ast-grep/ast-grep/releases"
        echo "   (CI enforces these rules; the hook is a fast local pre-check.)"
    fi
    echo ""
fi

echo "✅ All pre-commit checks passed!"
