# Production edge for Breakdown RS (ADR-025).
#
# Caddy is the *sole* public entry point: it terminates TLS with automatic
# ACME issuance/rotation (HTTP-01 by default) and reverse-proxies to the `api`
# service on the Docker-internal network. The API container publishes no host
# ports (see docker-compose.prod.yml).
#
# Env substitutions (supplied by the `caddy` service in docker-compose.prod.yml):
#   DOMAIN            – public site address, e.g. api.breakdown.example
#   PHOTO_MAX_SIZE_MB – request-body ceiling; kept aligned with the API's
#                       PHOTO_MAX_SIZE_MB so oversized uploads are rejected at
#                       the edge before they reach Axum.

{$DOMAIN} {
	# Modern TLS baseline (ADR-025): Caddy's defaults are already modern
	# (TLS 1.2+ with strong cipher suites, OCSP stapling). Make the protocol
	# floor explicit. ACME issuance stays enabled (automatic HTTPS).
	tls {
		protocols tls1.2 tls1.3
	}

	# HSTS (ADR-025): force HTTPS for one year, including subdomains. Preload
	# is left to the operator once the production domain is final.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Edge request-body ceiling, aligned with the API's PHOTO_MAX_SIZE_MB
	# (compose passes the same value to both services).
	request_body {
		max_size {$PHOTO_MAX_SIZE_MB:20}MB
	}

	# Default-deny posture: Caddy serves no static content. Unknown *paths*
	# are proxied to the API, which answers 404 with its own fallback — there
	# is deliberately no `file_server` and no catch-all that returns 200.
	#
	# Unknown hosts on :443 are rejected at the TLS layer (no certificate is
	# served for an unknown SNI); on :80 they hit the explicit 404 catch-all
	# below. Automatic HTTPS (HTTP-01 challenge + the HTTP->HTTPS redirect for
	# {$DOMAIN}) takes precedence over the catch-all and stays unaffected.
	reverse_proxy api:3000
}

# Default-deny for unknown hosts on :80 (any Host that does not match the site
# above) — answered 404 instead of being redirected. Do NOT add a catch-all on
# :443: that would make Caddy attempt ACME issuance for every unknown SNI and
# exhaust Let's Encrypt rate limits.
:80 {
	respond "Not Found" 404
}

# Internal TLS front for Garage S3 (ADR-024 / issue #156).
#
# Garage (`dxflrs/garage:v1.0.1`) has no built-in TLS on its S3 API endpoint,
# so the same Caddy instance terminates TLS for the photo/archival S3 links on
# an internal-only listener. The `api` container reaches it as
# `https://caddy:9443` (cert SAN `caddy`, issued by the `tls-provision` loop
# from the internal step-ca into the `tls_data` volume mounted at /certs).
# Garage's plaintext `:3900` stays Docker-internal and is never published.
#
# This block is deliberately file-certificate based (not ACME): step-ca's ACME
# challenge routing inside the Docker network would require DNS/SNI wiring for
# a hostname that only exists on the compose network; the provision loop keeps
# the short-TTL files fresh and Caddy reloads them on change/restart.
https://caddy:9443 {
	tls /certs/caddy.crt /certs/caddy.key
	reverse_proxy garage:3900
}
