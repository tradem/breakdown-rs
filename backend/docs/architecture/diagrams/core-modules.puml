' Bounded contexts inside backend/crates/core and their relationships.

skinparam shadowing false
skinparam linetype ortho

package "Production Hierarchy" {
  [ProjectId (tenant seam)] as project
  [season] as season
  [block] as block
  [episode] as episode
  [scene] as scene
  [shooting_day] as day
  [scene_shoot] as shoot
}

package "Wardrobe and Cast" {
  [character] as character
  [costume_category] as cat
  [piece (fundus)] as piece
  [outfit (look)] as outfit
}

package "Media" {
  [photo] as photo
}

package "Access, Operations, and AI" {
  [membership (block)] as membership
  [project_membership] as pmembership
  [settings (Vault refs)] as settings
  [audit] as audit
  [reporting] as reporting
  [ai (import)] as ai
  [ops (DLQ health)] as ops
  [shared (UUIDv7, jiff, sort keys)] as shared
}

project --> season : 1..n
season --> block : 1..n
block --> episode : 1..n
episode --> scene : 1..n
episode --> day : 1..n
scene --> shoot : 0..n (per day)
shoot --> day : scheduled on

season --> character : scopes
season --> cat : vocabulary
season <--> piece : m..n repertoire
piece ..> cat : optional category
character --> outfit : owns 0..n
outfit ..> piece : layers 0..n
scene ..> outfit : casts (SceneOutfitBeat)

piece ..> photo : piece photos
outfit ..> photo : outfit photos
shoot ..> photo : continuity photos

membership ..> block : block roles
pmembership ..> project : project roles
settings ..> reporting : archive credentials
settings ..> ai : provider API keys
ai ..> episode : applies drafts
shoot ..> reporting : Soll-Ist and Dispo

@enduml
