' Co-authored-by: gemini-4-carbon (google)
'
' Deployment view: hardened Arch Linux VPS with step-ca internal TLS mesh.

skinparam shadowing false
skinparam linetype ortho

node "Android / Desktop Device" {
  component "Flutter App (prod flavor)\nIntended ISRG Root CA from PINNED_CA_PEM\nor replaced prod/ca.pem (ADR-032)" as client
}

cloud "OIDC IdP\n(Logto Cloud / Zitadel)" as idp
cloud "Curated LLM Providers &\nExternal Report Backup" as ext

node "Arch Linux VPS (LUKS2 At-Rest Encryption, nftables, auditd — ADR-023 / ADR-026)" as vps {

  node "Caddy Reverse Proxy\nPublic :80/:443 (ACME TLS)\nInternal :9443 (Garage TLS)" as caddy

  node "step-ca + tls-provision\nInternal Root CA\n24h Leaf Certs (12h Renewal)" as stepca

  node "API Container\ncrates/api (:3000 internal)\nREQUIRE_IN_TRANSIT_TLS=true" as api

  together {
    database "PostgreSQL 16\nssl=on (verify-full)\nmigrator + app/projector pools" as pg
    node "stunnel (:9091 TLS)\n+ SierraDB 0.3.1 (:9090)" as sierra
    rectangle "Garage v1.0.1\n(Internal S3 Store)" as garage
    database "HashiCorp Vault 1.20\n(:8200 TLS, Transit + KV-v2)" as vault
  }
}

client --> caddy : HTTPS (:443)
client ..> idp : OIDC PKCE
caddy --> api : Docker-internal HTTP
caddy --> garage : proxies :9443 TLS -> S3
api --> pg : SQL over TLS (verify-full)
api --> sierra : rediss://stunnel:9091 (RESP3)
api --> caddy : https://caddy:9443 (S3 API)
api --> vault : https://vault:8200 (app token)
api --> idp : HTTPS JWKS
api ..> ext : HTTPS (AI + OpenDAL backup)
stepca ..> pg : issues 24h cert
stepca ..> sierra : issues 24h cert
stepca ..> caddy : issues 24h cert
stepca ..> vault : issues 24h cert

@enduml
