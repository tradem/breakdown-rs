@startuml core-domain-model
' SPDX-License-Identifier: AGPL-3.0
' Copyright (C) 2024-2026 Breakdown RS Contributors
' Co-authored-by: gemini-4-carbon (google)
'
' Core domain aggregates and value objects in backend/crates/core.
' Cross-aggregate links use UUIDv7 identifiers only.

skinparam shadowing false
skinparam packageStyle rectangle
skinparam entity {
  BackgroundColor #FFFFFF
}
hide circle
hide methods

package "Shared Value Objects" #EEEEEE {
  class ProjectId << (V) >> {
    + 0 : Uuid <<UUIDv7>>
  }
  class LexicalSortKey << (V) >> {
    + as_str : String
  }
  class AggregateVersion << (V) >> {
    + value : u64
  }
}

package "Production Aggregates" #F4F8FF {
  class SeasonAggregate << (A) >> {
    + id : SeasonId
    + project_id : ProjectId
    + number : u32
    + title : Option<String>
    + archived : bool
  }
  class BlockAggregate << (A) >> {
    + id : BlockId
    + project_id : ProjectId
    + season_id : SeasonId
    + number : u32
  }
  class EpisodeAggregate << (A) >> {
    + id : EpisodeId
    + project_id : ProjectId
    + block_id : BlockId
    + number : u32
  }
  class ShootingDayAggregate << (A) >> {
    + id : ShootingDayId
    + episode_id : EpisodeId
    + label : Option<String>
    + order_key : LexicalSortKey
    + date : Option<Date>
    + wrapped_at : Option<Timestamp>
    + archived : bool
  }
  class SceneAggregate << (A) >> {
    + id : Uuid
    + episode_id : EpisodeId
    + details : SceneDetails
    + characters : Vec<Uuid>
    + outfit_beats : Vec<SceneOutfitBeat>
    + shooting_days : Vec<ShootingDayId>
  }
  class SceneOutfitBeat << (V) >> {
    + character_id : Uuid
    + outfit_id : Uuid
    + order : u32
    + note : Option<String>
  }
  class SceneShootAggregate << (A) >> {
    + id : SceneShootId
    + scene_id : Uuid
    + shooting_day_id : ShootingDayId
    + planned_order : Option<u32>
    + actual_order : Option<u32>
    + status : SceneShootStatus
    + planned_order_frozen : bool
  }

  SceneAggregate "1" *-- "0..*" SceneOutfitBeat : outfit_beats
}

package "Wardrobe Aggregates" #FFF8F0 {
  class CharacterAggregate << (A) >> {
    + id : Uuid
    + season_id : SeasonId
    + name : String
    + is_extra : bool
    + measurements : CharacterMeasurements
  }
  class CostumeCategoryAggregate << (A) >> {
    + id : CostumeCategoryId
    + season_id : SeasonId
    + name : String
    + order_key : LexicalSortKey
    + archived : bool
  }
  class PieceAggregate << (A) >> {
    + id : PieceId
    + name : String
    + category_id : Option<CostumeCategoryId>
    + seasons : BTreeSet<SeasonId>
    + details : Vec<PieceDetail>
    + photos : Vec<Uuid>
  }
  class OutfitAggregate << (A) >> {
    + id : OutfitId
    + character_id : Uuid
    + name : String
    + piece_ids : Vec<PieceId>
    + variant_of : Option<OutfitId>
    + photos : Vec<Uuid>
  }
}

package "Media & Access Aggregates" #F4FFF4 {
  class PhotoAggregate << (A) >> {
    + id : PhotoId
    + binding : PhotoBinding
    + content_type : String
    + thumb_status : VariantStatus
    + medium_status : VariantStatus
  }
  class MembershipAggregate << (A) >> {
    + id : Uuid
    + block_id : BlockId
    + members : Map<UserId, MembershipState>
  }
  class ProjectMembershipAggregate << (A) >> {
    + project_id : ProjectId
    + entries : Map<UserId, Role>
  }
  class SettingsAggregate << (A) >> {
    + id : SettingsId
    + vault_key_id : String
  }
}

note bottom of MembershipAggregate
  MembershipState transitions from
  Pending { role } to Active { role }
  on AcceptInvitation.
  ProjectMembershipAggregate stores
  active costume Role entries directly.
end note

note bottom of SettingsAggregate
  SettingsAggregate stores no owner field.
  The projector recovers owner from
  EventMetadata.actor into projection_settings,
  where handlers check ownership.
end note

SeasonAggregate ..> ProjectId
BlockAggregate ..> SeasonAggregate : season_id
EpisodeAggregate ..> BlockAggregate : block_id
ShootingDayAggregate ..> EpisodeAggregate : episode_id
SceneAggregate ..> EpisodeAggregate : episode_id
SceneShootAggregate ..> SceneAggregate : scene_id
SceneShootAggregate ..> ShootingDayAggregate : shooting_day_id
CharacterAggregate ..> SeasonAggregate : season_id
CostumeCategoryAggregate ..> SeasonAggregate : season_id
PieceAggregate ..> SeasonAggregate : seasons (m..n)
PieceAggregate ..> CostumeCategoryAggregate : category_id
OutfitAggregate ..> CharacterAggregate : character_id
OutfitAggregate ..> PieceAggregate : piece_ids (0..n)
SceneOutfitBeat ..> OutfitAggregate : outfit_id
PhotoAggregate ..> PieceAggregate : Piece binding
PhotoAggregate ..> OutfitAggregate : Outfit binding
PhotoAggregate ..> SceneShootAggregate : Continuity binding

@enduml
