' Runtime view: piece photo upload with best-effort cleanup and thumbnail saga.

skinparam shadowing false
skinparam sequenceArrowThickness 2

participant "Flutter Client" as client
participant "POST /v1/pieces/{id}/photos\nHandler" as api
participant "Garage\n(S3 Store)" as s3
participant "Command Adapters\n(Photo + Wardrobe)" as svc
database "SierraDB" as es
participant "PhotoThumbnailSaga" as saga
database "PostgreSQL" as pg

client -> api : POST image bytes (JPEG/PNG/WebP)
activate api
api -> pg : load piece + AUTHZ-GATE\n(authorize_piece_in_project)
pg --> api : project_id (or 403 / 422)
api -> s3 : store raw Original bytes (PhotoId)
s3 --> api : stored
api -> svc : UploadPhoto + LinkPiecePhoto
activate svc
svc -> es : append PhotoUploaded + PiecePhotoLinked
es --> svc : versions
svc --> api : Ok(photo_version)
deactivate svc
api --> client : 201 Created (PhotoView, variants pending)
deactivate api

es ->> saga : PhotoUploaded
activate saga
saga -> s3 : read Original bytes
s3 --> saga : bytes
saga -> saga : decode image, strip EXIF,\nrender Thumb (max 200x200) and Medium (max 800x800)
saga -> s3 : overwrite Original (EXIF-stripped)\n+ store Thumb and Medium
saga -> svc : record generated variants
svc -> es : append variant events
deactivate saga

es ->> pg : project Photo and PiecePhoto rows

note right of api
  If UploadPhoto fails, no PhotoUploaded event exists
  and the handler attempts best-effort delete_all inline.
  If LinkPiecePhoto fails after UploadPhoto succeeds,
  the handler attempts delete_all and logs storage errors;
  periodic PhotoGcSweepTask reconciles any leftover blobs.
end note

@enduml
