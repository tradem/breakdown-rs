' Deployment view: local development stack and optional compose overlays.

skinparam shadowing false
skinparam linetype ortho

node "Developer Workstation" {

  node "Flutter App (dev flavor)\nAndroid Emulator / Desktop\nPinned dev/ca.pem" <<process>> as flutter

  node "cargo run --bin api\n0.0.0.0:3000\n(Migrator + App + Projector Pools)" <<process>> as app

  package "docker-compose.dev.yml" as dc {
    database "PostgreSQL 16\n:5432\n(migrator + app roles)" as pg
    database "SierraDB 0.3.1\n:9090 (RESP3)" as sierra
  }

  package "Optional Dev Overlays" as overlays {
    rectangle "Logto OIDC IdP\n:3301 HTTPS\n(docker-compose.idp.yml)" as idp
    rectangle "Garage S3\n:3900 HTTP\n(docker-compose.dev.ai.yml)" as garage
    database "HashiCorp Vault\n:8200 HTTP\n(docker-compose.dev.vault.yml)" as vault
  }
}

flutter --> app : HTTP/HTTPS REST + SSE
flutter ..> idp : OIDC PKCE (optional)
app --> pg : SQL
app --> sierra : RESP3
app ..> idp : JWKS (when OIDC_ISS is set)
app ..> garage : S3 API (photos + AI blobs)
app ..> vault : Transit + KV-v2 (optional)

@enduml
