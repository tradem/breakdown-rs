' Runtime view: end-to-end CQRS command, reservation claim, and lag sync.

skinparam shadowing false
skinparam sequenceArrowThickness 2

participant "Flutter Client\n(Riverpod)" as client
participant "Axum Handler\n(/v1/...)" as api
participant "Command Adapter\n(kameo_es)" as svc
participant "Aggregate\nActor" as agg
database "SierraDB\n(Event Store)" as es
participant "Projector\n(PostgresProcessor)" as proj
database "PostgreSQL\n(Projection)" as db

client -> api : POST /v1/... (JSON command)
activate api
api -> db : AuthZ check + optional 409 pre-check
db --> api : allowed + context
api -> svc : execute(command)
activate svc

opt Global uniqueness invariant (ADR-036)
  svc -> es : claim reservation-* (ExpectedVersion::Empty)
  es --> svc : claimed (or WrongVer -> 409 Conflict)
end

svc -> agg : handle(command)
activate agg
agg -> agg : check domain invariants
agg --> svc : Ok(Vec<Event>)
deactivate agg

svc -> es : append events (expected version)
activate es
es --> svc : new stream version
deactivate es
svc --> api : Ok((id, version))
deactivate svc
api --> client : 201 Created / 200 OK
deactivate api

client -> client : apply optimistic overlay

es ->> proj : async event delivery
activate proj
proj -> db : UPSERT projection\n(WHERE version < $N)
deactivate proj

client -> api : bounded-retry GET /v1/...
api -> db : SELECT projection
db --> api : projected DTO
api --> client : 200 OK (replaces overlay)

@enduml
