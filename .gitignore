# Environment variables
.env
.env.local
.env.*.local
.env.idp

# Dev TLS certs (generated by scripts/generate-dev-certs.sh)
dev-certs/

# Dev Vault state (scripts/enable-dev-vault.sh, issue #468): unseal key, app
# token, and the dev-only bootstrap seed. Never grant real-vault semantics.
backend/.vault-dev/

# Android release keystore material (never commit; see
# frontend-flutter/docs/release-signing-key-custody.md — D9, one key,
# backed up offline). Material flows through CI environment secrets only.
*.jks
*.keystore
frontend-flutter/android/key.properties
# Gradle-side decode target for CI's KEYSTORE_BASE64 (build/ trees are
# ignored anyway, but keep the decode dir explicitly out of any archive).
frontend-flutter/android/app/build/keystore/

# Design-token build (design/, scripts/build-tokens.sh): pinned Node
toolchain + Style Dictionary JSON intermediate (throwaway).
design/node_modules/
design/build/

# Rust build artifacts
target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Database
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp

# Cargo
# The backend is a deployable application (a Cargo workspace whose `api` crate is a
# binary), so its Cargo.lock is committed for reproducible builds and to let the
# security audit (`.github/workflows/audit.yml`) trigger on lockfile changes.
# **/Cargo.lock
# Machine-local cargo config (e.g. `[build] jobs` cap to protect low-RAM hosts
# from OOM during full-workspace builds). Never commit per-machine settings;
# CI and other contributors must not inherit them.
**/.cargo/config.toml

# Test coverage
coverage/
*.coverage
.coverage.*

# Mutation testing
mutants.out*/

# Agent/IDE configuration directories
.pi/**
backend/.pi/plugins/ast-bro/**

# arc42 documentation build artifacts
backend/docs/architecture/arc42-typst/dist/
# Generated diagram SVGs (rendered from backend/docs/architecture/diagrams/*.puml by build.sh)
backend/docs/architecture/arc42-typst/diagrams/

# Python
__pycache__/
*.pyc
